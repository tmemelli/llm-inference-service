GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CORS_ALLOWED_ORIGINS='["http://localhost:5500","https://app.thiagomemelli.com.br"]'
INFERENCE_RATE_LIMIT_PER_MINUTE=5
PROVIDER_POLICIES='{"groq":{"max_concurrent_requests":5,"timeout_seconds":15.0,"max_inference_retries":1,"retry_base_delay_seconds":0.5,"retry_max_exponential_delay_seconds":2.0,"retry_max_jitter_seconds":0.05,"model_fallbacks":{"openai/gpt-oss-20b":["openai/gpt-oss-120b"],"openai/gpt-oss-120b":["openai/gpt-oss-20b"]},"provider_fallbacks":[{"target_provider":"gemini","target_model":"gemini-3.1-flash-lite"}]},"gemini":{"max_concurrent_requests":2,"timeout_seconds":15.0,"max_inference_retries":1,"retry_base_delay_seconds":0.5,"retry_max_exponential_delay_seconds":2.0,"retry_max_jitter_seconds":0.05,"model_fallbacks":{},"provider_fallbacks":[]}}'
